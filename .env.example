# Placeholders only. Copy to .env (git-ignored) for local use; set real values in the host's secret store in production.

# --- Database (Neon). Keep sslmode=require. Never commit real values. ---
DB_JDBC_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
DB_POOL_MAX_SIZE=5

# --- Security ---
# Generate with: openssl rand -base64 48   (minimum 32 bytes)
JWT_SECRET=<long-random-secret>
JWT_ISSUER=devtrack-backend
JWT_AUDIENCE=devtrack-frontend
JWT_ACCESS_TOKEN_TTL=15m
# Comma-separated explicit origins of the React app; wildcards are rejected.
CORS_ALLOWED_ORIGINS=https://<your-frontend-domain>

# --- Runtime ---
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_TIME_ZONE=UTC

# --- Flyway: leave false except for the one-time baseline of the existing database ---
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
